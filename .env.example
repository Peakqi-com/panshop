# 複製成 .env.local 填值；.env.local 已 gitignore，另備份到 ~/.secrets/panshop.env

# 資料庫（必填）
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=panshop

# 媒體儲存（必填）：Vercel Blob store 的讀寫 token
BLOB_READ_WRITE_TOKEN=

# 後台 /admin 通行碼與金鑰加密主鑰（必填）：openssl rand -base64 32
ADMIN_PASSCODE=
SECRETS_MASTER_KEY=

# 上傳頁通行碼（選填；空白＝不限制）
UPLOAD_PASSCODE=

# 管線各 stage 之間自我呼叫用的共用密鑰（必填）：openssl rand -hex 24
WORKER_SECRET=
# Vercel Cron 呼叫 /api/cron/advance 用（正式站必填）：openssl rand -hex 24
CRON_SECRET=

# 模型金鑰：建議在 /admin 填入（加密存資料庫）；這裡只是備援
META_API_KEY=
BASETEN_API_KEY=
BASETEN_MODEL=meta-models/muse-spark-open-1026

# 本機 ffmpeg（選填；空白＝用 ffmpeg-static）
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

NEXT_PUBLIC_SITE_URL=http://localhost:3000
SAMPLE_VIDEO_URL=（範例影片的 Blob 網址，首頁「用範例影片試試」用）
